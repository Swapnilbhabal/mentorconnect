
# Copy this file to ".env" and fill in your values.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Any Gemini model your key can access. Change this if Google retires the default.
GEMINI_MODEL=

# Used to sign login tokens. Use a long random string (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=

# Fill the database with demo professors + a demo student when it is empty
AUTO_SEED=

# Allow POST /mentors/ without logging in (useful while testing at /docs). Set to false when you deploy.
ALLOW_OPEN_MENTOR_CREATION=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=